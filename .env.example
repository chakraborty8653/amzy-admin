# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public Edge Function URL (not a secret); use the Supabase project URL.
VITE_SUPABASE_FUNCTION_URL="https://yzoxjvxgepzfsnyeiwdx.supabase.co/functions/v1/teleflix-api"
VITE_SUPABASE_URL="https://yzoxjvxgepzfsnyeiwdx.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Configure the following as Supabase Edge Function secrets, not VITE variables.
TELEGRAM_BOT_ID=""
TELEGRAM_CLIENT_ID=""
TELEGRAM_CLIENT_SECRET=""
TELEGRAM_REDIRECT_URI="https://yzoxjvxgepzfsnyeiwdx.supabase.co/functions/v1/teleflix-api/auth/telegram/callback"
FRONTEND_URL="https://amzy.chakrabortycompliance.in"
# Optional comma-separated browser origins allowed by the Edge Function.
ADDITIONAL_FRONTEND_URLS=""
APP_REDIRECT_URI="amzy://auth"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL="https://yzoxjvxgepzfsnyeiwdx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side/Edge Function secret. Comma-separated Supabase Auth admin emails.
# Never expose this as a VITE_ variable.
ADMIN_SUPABASE_EMAILS=""
